# Copy to .dev.vars for local `astro dev`. Never commit .dev.vars.
# In production set these as Worker secrets: `npx wrangler secret put <name>`.

# OpenCode Go API key from https://opencode.ai/console
OPENCODE_GO_API_KEY="replace-me"

# Optional: override the upstream base (default https://opencode.ai/zen/go/v1).
# OPENCODE_GO_BASE_URL="http://127.0.0.1:9099/v1"

# Cloudflare Access. Required in production: without these the server refuses
# /api/* (fails closed). Set the hostname (e.g. team.cloudflareaccess.com) and
# the Access application's AUD tag. `astro dev` skips the check; `npm run
# preview` runs a production build, so /api/* returns 500 without these.
# CF_ACCESS_TEAM_DOMAIN="yourteam.cloudflareaccess.com"
# CF_ACCESS_AUD="your-access-app-aud"
